<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging config:
    * Default (local/dev/test): human-readable console with the requestId MDC.
    * `json` or `prod` profile: structured JSON via logstash-logback-encoder,
      suitable for shipping to a log aggregator.
  NEVER log secrets, tokens, passwords, or full email bodies.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Human-readable console (default) — includes the correlation id. -->
    <springProfile name="!json &amp; !prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{requestId:-}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Structured JSON for prod / when the `json` profile is active. -->
    <springProfile name="json | prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>requestId</includeMdcKeyName>
                <customFields>{"app":"mayoclone-api"}</customFields>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>
