# =============================================================================
# mayoclone-api — environment configuration
# =============================================================================
# Copy to `.env` (or export these in your process manager / k8s Secret) and fill
# in real values. NEVER commit a filled-in copy — this file holds ONLY safe
# placeholders. Every var here maps 1:1 to a `${...}` in src/main/resources/
# application.yml. Values marked [REQUIRED IN PROD] MUST be set to strong,
# non-default values before any real deployment.
#
# Generate the two crypto secrets with:
#   MAYOCLONE_JWT_SECRET :  openssl rand -base64 48    (>= 32 bytes of entropy)
#   MAYOCLONE_ENC_KEY    :  openssl rand -base64 32    (exactly 32 bytes → AES-256)
# =============================================================================

# ---- Auth / crypto secrets --------------------------------------------------
# [REQUIRED IN PROD] HMAC-SHA256 signing key for the access JWT. Dev falls back
# to a well-known insecure default; prod MUST override with 32+ random bytes.
MAYOCLONE_JWT_SECRET=replace-me-with-openssl-rand-base64-48

# [REQUIRED IN PROD] AES-256-GCM key for encrypting IMAP passwords + Gmail OAuth
# refresh tokens at rest. MUST base64-decode to EXACTLY 32 bytes. If unset, a
# DEV-ONLY default key is used (data encrypted with it is NOT secure).
MAYOCLONE_ENC_KEY=replace-me-with-openssl-rand-base64-32

# JWT issuer + token lifetimes (optional; sane defaults shown).
MAYOCLONE_JWT_ISSUER=mayoclone
MAYOCLONE_JWT_ACCESS_TTL=900        # access token TTL, seconds (15 min)
MAYOCLONE_JWT_REFRESH_TTL=604800    # refresh token TTL, seconds (7 days)

# ---- Database (Postgres) ----------------------------------------------------
# [REQUIRED IN PROD] Flyway owns the schema; Hibernate runs ddl-auto=validate.
MAYOCLONE_DB_URL=jdbc:postgresql://localhost:5432/mayoclone
MAYOCLONE_DB_USER=mayoclone
MAYOCLONE_DB_PASSWORD=replace-me-strong-db-password

# ---- Web / CORS / cookies ---------------------------------------------------
# [REQUIRED IN PROD] Comma-separated allowlist of browser origins allowed to
# call the API with credentials. Do NOT use "*" (credentials mode forbids it).
MAYOCLONE_CORS_ORIGINS=https://app.mayoclone.example

# [REQUIRED IN PROD] Set true so refresh/csrf cookies get the Secure flag.
# Requires the API to be served over HTTPS. Dev over http keeps this false.
MAYOCLONE_COOKIE_SECURE=true

# SPA base URL used to build the Gmail OAuth success redirect.
MAYOCLONE_FRONTEND_BASE_URL=https://app.mayoclone.example

# ---- Inbound forwarding webhook (PRIMARY ingestion path) --------------------
# [REQUIRED IN PROD if using the webhook path] Domain used to mint per-vendor
# forwarding addresses (<token>@<domain>). Must have MX records pointing at your
# inbound-email provider (Mailgun / SendGrid inbound parse).
MAYOCLONE_INBOUND_DOMAIN=inbound.mayoclone.example

# [REQUIRED IN PROD if using the webhook path] Shared HMAC-SHA256 secret the
# inbound-email provider signs POST /api/inbound/email with (X-Mayo-Signature).
# Dev falls back to an insecure default; prod MUST override.
MAYOCLONE_INBOUND_SIGNING_SECRET=replace-me-with-openssl-rand-base64-32

# [OPTIONAL] Mailgun HTTP webhook signing key (Dashboard → Sending → Webhooks).
# Enables the REAL Mailgun adapter at POST /api/inbound/mailgun, which verifies
# Mailgun's own signature (signature = hexHMAC_SHA256(key, timestamp + token)).
# EMPTY BY DEFAULT → that endpoint is DISABLED and returns 503. See docs/INGESTION.md.
MAYOCLONE_MAILGUN_SIGNING_KEY=

# ---- Gmail OAuth ingestion (optional) ---------------------------------------
# All three required ONLY to enable one-click Gmail connect. If any is blank the
# Gmail endpoints return 503 and the app still starts normally.
# NOTE: the restricted gmail.readonly scope requires Google OAuth app
# verification + a CASA security assessment before serving >100 users. See
# docs/INGESTION.md. Until then it works only for explicitly added test users.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.mayoclone.example/api/mail/gmail/callback

# ---- Gmail PUSH ingestion (Pub/Sub + users.watch, production scale) ----------
# Replaces per-mailbox polling with Google Pub/Sub push + Gmail history sync so
# ingestion scales to many restaurants. ALL blank by default → feature OFF:
# mailboxes fall back to the 60s poll and POST /api/inbound/gmail/push returns 503.
# Full setup (topic, publisher grant, push subscription with OIDC) is in
# docs/INGESTION.md → "Gmail push (production scale)" and docs/RUNBOOK.md.
#
# [ENABLES PUSH] The Pub/Sub topic passed to users.watch. When set, connected
# Gmail mailboxes are watched + renewed and driven by push instead of polled.
MAYOCLONE_GMAIL_PUBSUB_TOPIC=            # e.g. projects/my-proj/topics/gmail-push
#
# Verify the push request. PREFER the OIDC audience (production-grade): set this to
# the audience you configured on the push subscription's OIDC token; the endpoint
# then requires a Google-signed Bearer JWT with aud == this value.
MAYOCLONE_GMAIL_PUSH_AUDIENCE=           # e.g. https://api.mayoclone.example/api/inbound/gmail/push
# Fallback shared secret (used ONLY if audience is blank): the endpoint then
# requires a matching ?token= query param on the push URL (constant-time compare).
MAYOCLONE_GMAIL_PUSH_TOKEN=
# users.watch renewal cadence in ms (Gmail expires a watch after ~7 days). 6h default.
MAYOCLONE_GMAIL_WATCH_RENEW_MS=21600000
# When a topic is set, skip GMAIL_OAUTH vendors in the scheduled poll (push handles
# them). IMAP/other are always polled. Default true.
MAYOCLONE_POLL_SKIP_GMAIL_WHEN_PUSH=true

# ---- Email OTP verification (onboarding) ------------------------------------
# require-email-otp: when true, POST /api/auth/register REQUIRES a valid
#   emailVerificationToken (the JWT returned by POST /api/auth/otp/verify).
#   Default false → register works tokenless.
MAYOCLONE_REQUIRE_EMAIL_OTP=false
# otp-dev-mode: when true, POST /api/auth/otp/send ALSO returns the plaintext
#   "devCode" in the JSON so a local UI can show it without SMTP. MUST be false
#   in production (never leak the code).
MAYOCLONE_OTP_DEV_MODE=true
# OTP validity window (seconds) and email_verify JWT TTL (seconds).
MAYOCLONE_OTP_TTL=600
MAYOCLONE_EMAIL_VERIFY_TTL=900
# From-address on OTP emails (only used when real SMTP below is configured).
MAYOCLONE_OTP_FROM=no-reply@mayoclone.local
#
# Real SMTP (optional): set spring.mail.host to switch OTP delivery from the dev
# logger to real email (SmtpOtpSender activates on spring.mail.host). These are
# standard Spring Boot mail properties — pass as env or in application.yml.
#   SPRING_MAIL_HOST=smtp.example.com
#   SPRING_MAIL_PORT=587
#   SPRING_MAIL_USERNAME=apikey
#   SPRING_MAIL_PASSWORD=...
#   SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
#   SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# ---- Observability / tracing (optional) -------------------------------------
# OTLP trace sampling probability (0.0 = disabled, the default; 1.0 = all).
MAYOCLONE_TRACING_SAMPLING=0.0
# OTLP collector endpoint (only used when sampling > 0).
MAYOCLONE_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ---- File uploads (menu photos) ---------------------------------------------
# Local directory where uploaded menu-item images are stored and served from at
# /uploads/**. Relative paths resolve against the process working directory.
MAYOCLONE_UPLOAD_DIR=uploads

# ---- Spring profile ---------------------------------------------------------
# Set to `prod` (or include `json`) to emit structured JSON logs. See
# logback-spring.xml.
# SPRING_PROFILES_ACTIVE=prod
